# Unity project (unity/): tracked are Assets/ (with every .meta file), Packages/, ProjectSettings/.
# Everything else is regenerated by Unity or the IDE.
/unity/[Ll]ibrary/
/unity/[Tt]emp/
/unity/[Oo]bj/
/unity/[Ll]ogs/
/unity/[Uu]ser[Ss]ettings/
/unity/[Mm]emoryCaptures/
/unity/[Rr]ecordings/
/unity/[Bb]uild/
/unity/[Bb]uilds/
/unity/Data/
/unity/*.csproj
/unity/*.sln
/unity/*.slnx
/unity/.vs/
/unity/.idea/
/unity/.vscode/

# the web builds (gyroscope/sim/ …) are tracked on purpose: GitHub Pages serves them, it can't build Unity

# local notes
*.log
.DS_Store
